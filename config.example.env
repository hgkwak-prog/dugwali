# --- 슬랙 (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 내 슬랙 멤버 ID (프로필 > 더보기 > 멤버 ID 복사). 이 사람의 DM에만 반응합니다.
OWNER_SLACK_USER_ID=U0XXXXXXX

# --- 경로 ---
# 로컬 데이터(SQLite). 네트워크 드라이브에 두지 마세요.
DATA_DIR=./data
# 업무 로그(Markdown)와 전사문을 둘 곳. NAS 경로 가능 (예: Z:\worklog)
LOG_DIR=./data/worklog
TRANSCRIPT_DIR=./data/transcripts
# 안드로이드 통화 녹음이 동기화되는 폴더. 비워 두면 통화 감시를 끕니다.
CALL_DIR=

# --- LLM (구독 계정으로 로그인한 Claude Code) ---
CLAUDE_BIN=claude
# 비우면 Claude Code 기본 모델
CLAUDE_MODEL=
LLM_TIMEOUT=180
# 실제 통화 전사문을 자동으로 LLM에 보낼지. false면 통화마다 버튼을 눌러야 보냅니다.
SEND_CALLS_TO_LLM=false
# 금액도 가릴지 (기본은 전화번호·이메일·주민번호·계좌류만 가림)
MASK_AMOUNTS=false

# --- 전사 ---
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE=int8
# 화자 구분을 쓰려면 Hugging Face 토큰 입력 (pyannote 설치 필요)
HF_TOKEN=

# --- 일일 다이제스트 ---
DIGEST_TIME=17:30
