# --- 슬랙 (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 내 슬랙 멤버 ID (프로필 > 더보기 > 멤버 ID 복사). 이 사람의 DM에만 반응합니다.
OWNER_SLACK_USER_ID=U0XXXXXXX

# --- 경로 ---
# 로컬 데이터(SQLite). 네트워크 드라이브에 두지 마세요.
DATA_DIR=./data
# 업무 로그(Markdown)와 전사문을 둘 곳. NAS 경로 가능 (예: Z:\worklog)
LOG_DIR=./data/worklog
TRANSCRIPT_DIR=./data/transcripts
# 내 정리 기준(프로필) 파일. 비우면 DATA_DIR 안의 profile.md
PROFILE_PATH=
# 안드로이드 통화 녹음이 동기화되는 폴더. 비워 두면 통화 감시를 끕니다.
CALL_DIR=

# --- LLM ---
# claude_code: 구독 계정으로 로그인한 Claude Code를 호출 (기본)
# api: Claude API 키로 호출. pip install -r requirements-api.txt 필요
LLM_PROVIDER=claude_code
# 하루 LLM 호출 상한. 닿으면 원문만 보관하고 `조치` 목록에 올립니다. 0이면 무제한
LLM_DAILY_LIMIT=200

# LLM_PROVIDER=claude_code일 때
CLAUDE_BIN=claude
# 비우면 Claude Code 기본 모델
CLAUDE_MODEL=
LLM_TIMEOUT=180

# LLM_PROVIDER=api일 때
# 비우면 ANTHROPIC_API_KEY 환경 변수 등 SDK 기본 경로에서 찾습니다
LLM_API_KEY=
# 더 싼 모델: claude-sonnet-5-5, claude-haiku-5-5
LLM_API_MODEL=claude-opus-5-5
# low | medium | high. 메모 정리는 low로 충분합니다. 이 설정을 받지 않는 구형 모델이면 비웁니다
LLM_API_EFFORT=low
# 사내 게이트웨이 등 다른 주소로 보낼 때만
LLM_API_BASE_URL=

# 통화·음성 메모 전사문을 자동으로 LLM에 보낼지. false면 건마다 버튼을 눌러야 보냅니다.
SEND_CALLS_TO_LLM=false
# 금액도 가릴지 (기본은 전화번호·이메일·주민번호·계좌류만 가림)
MASK_AMOUNTS=false

# --- 전사 ---
# local: 이 PC에서 전사 (기본). 음성이 밖으로 나가지 않습니다
# api: 음성 파일을 외부 전사 API로 보냅니다. 회사가 승인한 제공자만 연결하세요
STT_PROVIDER=local
# 말하는 언어. 비우면 자동 감지
STT_LANGUAGE=ko

# STT_PROVIDER=api일 때 (OpenAI 호환 형식: POST {주소}/audio/transcriptions)
STT_API_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_API_MODEL=whisper-1

# STT_PROVIDER=local일 때
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE=int8
# 화자 구분을 쓰려면 Hugging Face 토큰 입력 (pyannote 설치 필요)
HF_TOKEN=

# --- 일일 다이제스트 ---
DIGEST_TIME=17:30

# --- 대시보드 ---
# 이 PC의 브라우저에서만 열립니다: http://127.0.0.1:8765/  (0이면 띄우지 않음)
DASHBOARD_PORT=8765
